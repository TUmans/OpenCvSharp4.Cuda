<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
		<NoBuild>true</NoBuild>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<PackageId>OpenCvSharp4Cuda.NvidiaRedist.win</PackageId>
		<Title>NVIDIA Redistributable DLLs for OpenCvSharp.Cuda (Windows)</Title>
		<Authors>T.Umans</Authors>
		<Version>12.8.0.4</Version>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/TUmans/OpenCvSharp4.Cuda</PackageProjectUrl>
		<PackageIcon>opencvsharp.cuda.png</PackageIcon>
		<Description>Meta-package that installs all NVIDIA CUDA redistributable DLLs required for OpenCvSharp4.Cuda on Windows. Pulls in Core (cudart, npp, cudnn) and Compute (cublas, cufft, curand, cusolver, cusparse).</Description>
		<PackageTags>Image Processing OpenCV Wrapper cuda nvidia windows</PackageTags>
		<Copyright>Copyright 2008-2026</Copyright>
		<RepositoryUrl>https://github.com/TUmans/OpenCvSharp4.Cuda</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageReadmeFile>README.NvidiaRedist.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon\opencvsharp.cuda.png" Pack="true" PackagePath="" />
		<None Include="README.NvidiaRedist.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenCvSharp4Cuda.NvidiaRedist.win.001.part" Version="1.0.0" />
		<PackageReference Include="OpenCvSharp4Cuda.NvidiaRedist.win.002.part" Version="1.0.0" />
		<PackageReference Include="OpenCvSharp4Cuda.NvidiaRedist.win.003.part" Version="1.0.0" />
		<PackageReference Include="OpenCvSharp4Cuda.NvidiaRedist.win.004.part" Version="1.0.0" />
		<PackageReference Include="OpenCvSharp4Cuda.NvidiaRedist.win.005.part" Version="1.0.0" />
	</ItemGroup>



	<Target Name="UnzipCudaRedist" AfterTargets="Build">
		<PropertyGroup>
			<NativeDir>$(OutDir)runtimes\win-x64\native\</NativeDir>
			<MarkerFile>$(NativeDir)nppc64_12.dll</MarkerFile>
			<CombinedZip>$(NativeDir)Nvidia.Redist.zip</CombinedZip>
		</PropertyGroup>

		<ItemGroup>
			<CudaChunks Include="$(NativeDir)Nvidia.Redist.zip.*" />
		</ItemGroup>

		<PropertyGroup>
			<NeedsCudaExtract Condition="'@(CudaChunks)' != '' AND !Exists('$(MarkerFile)')">true</NeedsCudaExtract>
		</PropertyGroup>

		<Message Importance="High" Text="[OpenCvSharp.Cuda] Detected CUDA split-archive. Merging parts..." Condition="'$(NeedsCudaExtract)' == 'true'" />
		<Exec Command="cmd.exe /c copy /b &quot;$(NativeDir)Nvidia.Redist.zip.*&quot; &quot;$(CombinedZip)&quot;" Condition="'$(NeedsCudaExtract)' == 'true'" />

		<Message Importance="High" Text="[OpenCvSharp.Cuda] Extracting CUDA binaries (this may take a moment)..." Condition="'$(NeedsCudaExtract)' == 'true'" />
		<Exec Command="powershell -Command &quot;Expand-Archive -Path '$(CombinedZip)' -DestinationPath '$(NativeDir)' -Force&quot;" Condition="'$(NeedsCudaExtract)' == 'true'" />

		<Delete Files="$(CombinedZip)" Condition="'$(NeedsCudaExtract)' == 'true' AND Exists('$(CombinedZip)')" />
		<Delete Files="@(CudaChunks)" Condition="'$(NeedsCudaExtract)' == 'true'" />

		<Message Importance="High" Text="[OpenCvSharp.Cuda] CUDA Binaries are ready." Condition="'$(NeedsCudaExtract)' == 'true'" />

	</Target>
</Project>